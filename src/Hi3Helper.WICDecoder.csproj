<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <WindowsSdkPackageVersion>10.0.26100.84</WindowsSdkPackageVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <Platforms>x64;AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <DebugType>portable</DebugType>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <TieredCompilation>true</TieredCompilation>
        <!-- Assembly Info Properties -->
        <AssemblyName>Hi3Helper.WICDecoderExtension</AssemblyName>
        <ProductName>Hi3Helper.WICDecoderExtension</ProductName>
        <Product>Hi3Helper.WICDecoderExtension</Product>
        <Description>An extension library to add IWICDecoder implementation for WebP, JPEG XL, HEIF/AVIF decoding support.</Description>
        <Company>Collapse Launcher Team</Company>
        <Authors>$(Company). neon-nyan, Cry0, bagusnl, shatyuka, gablm.</Authors>
        <Copyright>Copyright 2022-2026 $(Company)</Copyright>
        <IsAotCompatible>true</IsAotCompatible>
        <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <Optimize>True</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <Optimize>False</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Hi3Helper.Win32\Hi3Helper.Win32.csproj" />
      <ProjectReference Include="..\Hi3Helper.Win32\WinRT\Hi3Helper.Win32.WinRT.csproj" />
    </ItemGroup>
</Project>
