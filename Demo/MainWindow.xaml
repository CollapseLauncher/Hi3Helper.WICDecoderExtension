<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Demo">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    <Grid>
        <Grid.Resources>
            <AcrylicBrush x:Key="AcrylicBackgroundBrush"
                          TintColor="#222222"
                          TintOpacity="0.1"
                          TintLuminosityOpacity="0.5"/>
        </Grid.Resources>
        <Grid Margin="32"
              CornerRadius="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Image Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Right" Source="Samples/default_zzz.avif"/>
                <Grid Padding="16"
                      Margin="16"
                      CornerRadius="16"
                      Background="{StaticResource AcrylicBackgroundBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="AVIF"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Image Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Right" Source="Samples/GamePreviewProtoDesign-V2Kiana.jxl"/>
                <Grid Padding="16"
                      Margin="16"
                      CornerRadius="16"
                      Background="{StaticResource AcrylicBackgroundBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="JXL"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Image Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Right" Source="Samples/GamePreviewProtoDesign-V2OldZenless.webp"/>
                <Grid Padding="16"
                      Margin="16"
                      CornerRadius="16"
                      Background="{StaticResource AcrylicBackgroundBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="WEBP"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="3">
                <Image Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center" Source="Samples/pixelframe-design_pokopia-font-logo.jpg"/>
                <Grid Padding="16"
                      Margin="16"
                      CornerRadius="16"
                      Background="{StaticResource AcrylicBackgroundBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="JPEG"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
